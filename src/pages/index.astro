---
import Base from "@/layouts/Base.astro";
---

<Base title="Marco Bernier — Chef Cuisiner">
  <section class="flex flex-col items-center justify-center min-h-[75vh] py-12 md:py-16 px-4 text-center">
    <!-- Center Monogram Logo -->
    <div class="mb-10 max-w-[280px] md:max-w-[360px] animate-fade-in select-none">
      <img
        src="/images/logo-marco-bernier.png"
        alt="Marco Bernier Logo"
        width={360}
        height={90}
        class="w-full h-auto"
      />
    </div>

    <!-- Title and Subtitle -->
    <h1 class="font-secondary text-[36px] md:text-[44px] font-normal tracking-[-0.01em] text-[#371e0f] mb-3 leading-tight">
      Chef Cuisiner
    </h1>
    <p class="font-primary text-[13px] md:text-[14px] font-light text-text/60 tracking-[0.2em] uppercase mb-8">
      Site web bientôt disponible
    </p>

    <!-- Button -->
    <div class="mb-8">
      <a
        href="mailto:chef@marcobernier.com"
        class="inline-block bg-[#503323] hover:bg-[#371e0f] text-white font-primary text-[11px] md:text-xs font-semibold tracking-[0.2em] uppercase px-10 py-4 transition-all duration-300 ease-in-out transform hover:-translate-y-[1px] select-none"
      >
        ME CONTACTER
      </a>
    </div>

    <!-- Contact details -->
    <div class="flex flex-col space-y-1 font-primary text-xs md:text-sm font-light text-[#211c17]/85 tracking-widest uppercase">
      <a href="tel:+590690707552" class="hover:text-primary transition-colors duration-300">
        +590 690 70 75 52
      </a>
      <a href="mailto:chef@marcobernier.com" class="hover:text-primary transition-colors duration-300 font-medium normal-case">
        chef@marcobernier.com
      </a>
    </div>

    <!-- Visual Gallery -->
    <div class="mt-20 mb-12 w-full max-w-[560px] px-4">
      <div class="grid grid-cols-4 gap-3 md:gap-4 items-start justify-center">
        <!-- Image 1 -->
        <div class="relative overflow-hidden group select-none shadow-md border border-border/10 aspect-[3/4]">
          <img
            src="/images/gallery-1.jpg"
            alt="Chef Cuisiner - Plat 1"
            width={112}
            height={140}
            class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-in-out"
          />
        </div>

        <!-- Image 2 (shifted down by 24px) -->
        <div class="relative overflow-hidden group select-none shadow-md border border-border/10 aspect-[3/4] translate-y-[24px]">
          <img
            src="/images/gallery-2.jpg"
            alt="Chef Cuisiner - Plat 2"
            width={112}
            height={141}
            class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-in-out"
          />
        </div>

        <!-- Image 3 -->
        <div class="relative overflow-hidden group select-none shadow-md border border-border/10 aspect-[3/4]">
          <img
            src="/images/gallery-3.jpg"
            alt="Chef Cuisiner - Plat 3"
            width={111}
            height={140}
            class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-in-out"
          />
        </div>

        <!-- Image 4 (shifted down by 24px) -->
        <div class="relative overflow-hidden group select-none shadow-md border border-border/10 aspect-[3/4] translate-y-[24px]">
          <img
            src="/images/gallery-4.jpg"
            alt="Chef Cuisiner - Plat 4"
            width={112}
            height={140}
            class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-in-out"
          />
        </div>
      </div>
    </div>
  </section>
</Base>
